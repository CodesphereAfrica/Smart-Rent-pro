{
    "name": "smartrentpro/smart-rent-pro",
    "description": "Smart Rent Pro — multi-tenant property management system (plain PHP 7.3, no app framework).",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=7.3 <7.4",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-curl": "*",
        "ext-gd": "*",
        "ext-fileinfo": "*",
        "vlucas/phpdotenv": "^4.2",
        "monolog/monolog": "^2.9",
        "respect/validation": "^2.2",
        "firebase/php-jwt": "^5.5",
        "phpmailer/phpmailer": "^6.8",
        "mpdf/mpdf": "^8.1",
        "phpoffice/phpspreadsheet": "^1.29",
        "endroid/qr-code": "^3.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "SmartRentPro\\Sms\\": "includes/sms/"
        },
        "files": [
            "includes/functions.php"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "7.3.33"
        }
    },
    "scripts": {
        "migrate": "php database/migrate.php",
        "serve": "php -S localhost:8000 -t public"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}