APP_NAME="Smart Rent Pro"
APP_URL="http://localhost:8000"
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE="Africa/Kigali"
SESSION_TIMEOUT=1800
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MIN=15

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smart_rent_pro
DB_USER=root
DB_PASS=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME="Smart Rent Pro"

SMS_DRIVER=log
JWT_SECRET=replace-with-64-char-random-string
JWT_TTL=3600
DEFAULT_CURRENCY=RWF
DEFAULT_LANGUAGE=en